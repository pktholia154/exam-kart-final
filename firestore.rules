rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'seoslug']) && data.keys().size() == 2 &&
             data.name is string && data.name.size() <= 100 &&
             data.seoslug is string && data.seoslug.size() <= 100;
    }
    
    function isValidBook(data) {
      return data.keys().hasAll([
        'title', 'seoslug', 'category', 'publsher', 'pdfurl', 'sampleurl', 
        'listprice', 'buyprice', 'seoDescription', 'fullDescription', 
        'tags', 'averageRating', 'reviewCount', 'language', 'pageCount', 'fileSizeInMB'
      ]) && data.keys().size() == 16 &&
      data.title is string && data.title.size() <= 200 &&
      data.seoslug is string && data.seoslug.size() <= 200 &&
      data.category is string && data.category.size() <= 100 &&
      data.publsher is string && data.publsher.size() <= 100 &&
      data.pdfurl is string && data.pdfurl.size() <= 500 &&
      data.sampleurl is string && data.sampleurl.size() <= 500 &&
      data.listprice is string && data.listprice.size() <= 20 &&
      data.buyprice is string && data.buyprice.size() <= 20 &&
      data.seoDescription is string && data.seoDescription.size() <= 500 &&
      data.fullDescription is string && data.fullDescription.size() <= 5000 &&
      data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string) &&
      data.averageRating is number &&
      data.reviewCount is number &&
      data.language is string && data.language.size() <= 50 &&
      data.pageCount is number &&
      data.fileSizeInMB is number;
    }
    
    function isValidPurchase(data) {
      return data.keys().hasAll(['userId', 'bookId', 'title', 'seoslug', 'category', 'purchasedAt']) &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.bookId is string && data.bookId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.seoslug is string && data.seoslug.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.purchasedAt is string && data.purchasedAt.size() <= 100 &&
             (!data.keys().hasAny(['orderId']) || (data.orderId is string && data.orderId.size() <= 128)) &&
             (!data.keys().hasAny(['paymentId']) || (data.paymentId is string && data.paymentId.size() <= 128));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['bookId', 'userId', 'userName', 'rating', 'comment', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 7 &&
             data.bookId is string && data.bookId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'referral_code', 'wallet_balance', 'created_at']) &&
             data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
             data.referral_code is string && data.referral_code.size() <= 32 &&
             data.wallet_balance is number &&
             data.created_at is string && data.created_at.size() <= 100;
    }

    function isValidReferral(data) {
      return data.keys().hasAll(['referrer_user_id', 'referred_user_id', 'status', 'created_at']) &&
             data.referrer_user_id is string && data.referrer_user_id.size() <= 128 &&
             data.referred_user_id is string && data.referred_user_id.size() <= 128 &&
             data.status is string && (data.status == 'clicked' || data.status == 'signed_up' || data.status == 'pending' || data.status == 'rewarded' || data.status == 'rejected') &&
             data.created_at is string && data.created_at.size() <= 100;
    }

    function isValidWalletTransaction(data) {
      return data.keys().hasAll(['user_id', 'amount', 'type', 'created_at']) &&
             data.user_id is string && data.user_id.size() <= 128 &&
             data.amount is number &&
             data.type is string && (data.type == 'referral_credit' || data.type == 'purchase_debit' || data.type == 'reversal') &&
             data.created_at is string && data.created_at.size() <= 100;
    }
    
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isSignedIn() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isSignedIn();
      // No updates allowed for now
    }
    
    match /books/{bookId} {
      allow get: if isValidId(bookId);
      allow list: if true;
      allow create: if isSignedIn() && isValidId(bookId) && isValidBook(incoming());
      allow update: if isSignedIn() && isValidId(bookId) && isValidBook(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['averageRating', 'reviewCount']);
      allow delete: if isSignedIn();
    }
    
    match /purchases/{purchaseId} {
      allow get: if isSignedIn() && isValidId(purchaseId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(purchaseId) && isValidPurchase(incoming());
      // No updates or deletes allowed for now
    }
    
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming());
      allow update: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming()) && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(reviewId) && existing().userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
    }

    match /referrals/{referralId} {
      allow get: if isSignedIn() && isValidId(referralId);
      allow list: if isSignedIn() && (resource.data.referrer_user_id == request.auth.uid || resource.data.referred_user_id == request.auth.uid);
      allow create: if isSignedIn() && isValidId(referralId) && isValidReferral(incoming());
      allow update: if isSignedIn() && isValidId(referralId);
    }

    match /wallet_transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId);
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && isValidId(transactionId) && isValidWalletTransaction(incoming());
    }
  }
}

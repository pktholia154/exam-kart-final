{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Book category",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "seoslug": { "type": "string", "maxLength": 100 }
      },
      "required": ["name", "seoslug"]
    },
    "Book": {
      "title": "Book",
      "description": "E-Book",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "seoslug": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "publisher": { "type": "string", "maxLength": 100 },
        "pdfurl": { "type": "string", "maxLength": 500 },
        "sampleurl": { "type": "string", "maxLength": 500 },
        "listprice": { "type": "string", "maxLength": 20 },
        "buyprice": { "type": "string", "maxLength": 20 },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "fullDescription": { "type": "string", "maxLength": 5000 },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 50 }, "maxItems": 10 },
        "averageRating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "language": { "type": "string", "maxLength": 50 },
        "pageCount": { "type": "number" },
        "fileSizeInMB": { "type": "number" }
      },
      "required": [
        "title",
        "seoslug",
        "category",
        "publisher",
        "pdfurl",
        "sampleurl",
        "listprice",
        "buyprice",
        "seoDescription",
        "fullDescription",
        "tags",
        "averageRating",
        "reviewCount",
        "language",
        "pageCount",
        "fileSizeInMB"
      ]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Book purchase record by user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "bookId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "seoslug": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "purchasedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["userId", "bookId", "title", "seoslug", "category", "purchasedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "User review for a book",
      "type": "object",
      "properties": {
        "bookId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["bookId", "userId", "userName", "rating", "comment", "createdAt", "updatedAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile with referral code and wallet store credit balance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "referral_code": { "type": "string", "maxLength": 32 },
        "referred_by_user_id": { "type": "string", "maxLength": 128 },
        "referred_by_code": { "type": "string", "maxLength": 32 },
        "wallet_balance": { "type": "number" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "referral_code", "wallet_balance", "created_at"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Referral tracking record",
      "type": "object",
      "properties": {
        "referrer_user_id": { "type": "string", "maxLength": 128 },
        "referred_user_id": { "type": "string", "maxLength": 128 },
        "order_id": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["clicked", "signed_up", "pending", "rewarded", "rejected"] },
        "reward_amount": { "type": "number" },
        "purchase_amount": { "type": "number" },
        "created_at": { "type": "string", "maxLength": 100 },
        "reward_available_at": { "type": "string", "maxLength": 100 }
      },
      "required": ["referrer_user_id", "referred_user_id", "status", "created_at"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Ledger entry for user wallet credit/debit",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["referral_credit", "purchase_debit", "reversal"] },
        "description": { "type": "string", "maxLength": 500 },
        "referral_id": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string", "maxLength": 100 }
      },
      "required": ["user_id", "amount", "type", "created_at"]
    }
  },
  "firestore": {
    "categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories collection"
    },
    "books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Books collection"
    },
    "purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Purchases collection"
    },
    "reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews collection"
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users profile collection"
    },
    "referrals/{referralId}": {
      "schema": { "$ref": "#/entities/Referral" },
      "description": "Referrals tracking collection"
    },
    "wallet_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Wallet transaction ledger collection"
    }
  }
}
